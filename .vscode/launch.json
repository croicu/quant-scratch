{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Python: Run stock-quote (CLI)",
      "type": "debugpy",
      "request": "launch",
      "module": "stock_quote.cli",
      "args": ["${input:ticker}", "--provider", "yahoo"],
      "console": "integratedTerminal",
      "justMyCode": false
    },
    {
      "name": "Python: Run day-chart (CLI)",
      "type": "debugpy",
      "request": "launch",
      "module": "day_chart.cli",
      "args": ["${input:ticker}"],
      "console": "integratedTerminal",
      "justMyCode": false
    },
    {
      "name": "Python: Run day-chart (CLI, 7-day range)",
      "type": "debugpy",
      "request": "launch",
      "module": "day_chart.cli",
      "args": ["${input:ticker}", "--provider", "quant-data", "--start-date", "${input:startDate}"],
      "console": "integratedTerminal",
      "justMyCode": false
    },
    {
      "name": "Python: Run Unit Tests",
      "type": "debugpy",
      "request": "launch",
      "module": "pytest",
      "args": ["-v", "-s", "-x", "tests/unit"],
      "console": "integratedTerminal",
      "justMyCode": false
    },
    {
      "name": "Python: Run Integration Tests",
      "type": "debugpy",
      "request": "launch",
      "module": "pytest",
      "args": ["-v", "-s", "-x", "tests/integration"],
      "console": "integratedTerminal",
      "justMyCode": false
    },
    {
      "name": "Python: Run All Tests",
      "type": "debugpy",
      "request": "launch",
      "module": "pytest",
      "args": ["-v", "-s", "-x"],
      "console": "integratedTerminal",
      "justMyCode": false
    }
  ],
  "inputs": [
    {
      "id": "ticker",
      "type": "promptString",
      "description": "Stock ticker symbol",
      "default": "AAPL"
    },
    {
      "id": "startDate",
      "type": "promptString",
      "description": "Range start date (YYYY-MM-DD) -- end defaults to today (or the last trading day if today is a weekend), giving a 7-day range with the default below",
      "default": "2026-07-27"
    }
  ]
}
