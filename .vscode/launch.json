{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Python: Run stock-quote (CLI)",
      "type": "debugpy",
      "request": "launch",
      "module": "stock_quote.cli",
      "args": ["${input:ticker}", "--provider", "yahoo"],
      "console": "integratedTerminal",
      "justMyCode": false
    },
    {
      "name": "Python: Run day-chart (CLI)",
      "type": "debugpy",
      "request": "launch",
      "module": "day_chart.cli",
      "args": ["${input:ticker}"],
      "console": "integratedTerminal",
      "justMyCode": false
    },
    {
      "name": "Python: Run day-chart (CLI, 7-day range)",
      "type": "debugpy",
      "request": "launch",
      "module": "day_chart.cli",
      "args": ["${input:ticker}", "--provider", "quant-data", "--start-date", "${input:startDate}"],
      "console": "integratedTerminal",
      "justMyCode": false
    },
    {
      "name": "Python: Run day-chart (CLI, start date, end date)",
      "type": "debugpy",
      "request": "launch",
      "module": "day_chart.cli",
      "args": ["${input:ticker}", "--provider", "quant-data", "--start-date", "${input:startDate}", "--end-date", "${input:endDate}"],
      "console": "integratedTerminal",
      "justMyCode": false
    },
    {
      "name": "Python: Run day-chart (CLI, ibkr, start date, end date)",
      "type": "debugpy",
      "request": "launch",
      "module": "day_chart.cli",
      "args": ["${input:ticker}", "--provider", "ibkr", "--start-date", "${input:startDate}", "--end-date", "${input:endDate}"],
      "console": "integratedTerminal",
      "justMyCode": false
    },
    {
      "name": "Python: Run day-chart (CLI, databento, start date, end date)",
      "type": "debugpy",
      "request": "launch",
      "module": "day_chart.cli",
      "args": ["${input:ticker}", "--provider", "databento", "--start-date", "${input:startDate}", "--end-date", "${input:endDate}"],
      "console": "integratedTerminal",
      "justMyCode": false
    },
    {
      "name": "Python: Run day-chart (CLI, yahoo, start date, end date)",
      "type": "debugpy",
      "request": "launch",
      "module": "day_chart.cli",
      "args": ["${input:ticker}", "--provider", "yahoo", "--start-date", "${input:startDate}", "--end-date", "${input:endDate}"],
      "console": "integratedTerminal",
      "justMyCode": false
    },
    {
      "name": "Python: Run open-quant-data (CLI)",
      "type": "debugpy",
      "request": "launch",
      "module": "open_quant_data.cli",
      "args": ["${workspaceFolder}/${input:spreadsheet}"],
      "console": "integratedTerminal",
      "justMyCode": false
    },
    {
      "name": "Python: Run Unit Tests",
      "type": "debugpy",
      "request": "launch",
      "module": "pytest",
      "args": ["-v", "-s", "-x", "tests/unit"],
      "console": "integratedTerminal",
      "justMyCode": false
    },
    {
      "name": "Python: Run Integration Tests",
      "type": "debugpy",
      "request": "launch",
      "module": "pytest",
      "args": ["-v", "-s", "-x", "tests/integration"],
      "console": "integratedTerminal",
      "justMyCode": false
    },
    {
      "name": "Python: Run All Tests",
      "type": "debugpy",
      "request": "launch",
      "module": "pytest",
      "args": ["-v", "-s", "-x"],
      "console": "integratedTerminal",
      "justMyCode": false
    }
  ],
  "inputs": [
    {
      "id": "ticker",
      "type": "promptString",
      "description": "Stock ticker symbol",
      "default": "AAPL"
    },
    {
      "id": "startDate",
      "type": "promptString",
      "description": "Range start date (YYYY-MM-DD) -- end defaults to today (or the last trading day if today is a weekend), giving a 7-day range with the default below",
      "default": "2026-07-28"
    },
    {
      "id": "endDate",
      "type": "promptString",
      "description": "Range end date (YYYY-MM-DD)",
      "default": "2026-07-30"
    },
    {
      "id": "spreadsheet",
      "type": "pickString",
      "description": "Which workbook to open (add new entries here as you add spreadsheets under public/reports/ or local/reports/)",
      "options": [
        "public/reports/sample.xlsx",
        "local/reports/SPY - Price and Volume.xlsx",
        "local/reports/SPY - Staging.xlsx",
        "local/reports/SPY - Pending Manual Resolution.xlsx",
        "local/reports/SPY - Archive.xlsx"
      ],
      "default": "public/reports/sample.xlsx"
    }
  ]
}
